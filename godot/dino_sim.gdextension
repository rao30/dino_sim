[configuration]

entry_symbol = "dino_library_init"
compatibility_minimum = 4.4
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libdino_godot.so"
linux.release.x86_64 = "res://bin/libdino_godot.so"
windows.debug.x86_64 = "res://bin/dino_godot.dll"
windows.release.x86_64 = "res://bin/dino_godot.dll"
macos.debug = "res://bin/libdino_godot.dylib"
macos.release = "res://bin/libdino_godot.dylib"
